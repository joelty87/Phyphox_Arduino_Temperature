<?xml version="1.0" encoding="UTF-8"?>
<phyphox version="1.10">
    <title>Nano_Joël Temperature</title>

    <data-containers>
        <container size="1000" static="false">time</container>
        <container size="1000" static="false">temperature</container>
    </data-containers>

    <bluetooth name="Nano_Joël">
        <input char="phyphoxData">
            <output component="time"/>
            <output component="temperature"/>
        </input>
    </bluetooth>

    <views>
        <view label="Temperature">

            <graph label="Temperature vs Time">

                <input axis="x">
                    <source>time</source>
                </input>

                <input axis="y">
                    <source>temperature</source>
                </input>

                <label axis="x">Time (s)</label>
                <label axis="y">Temperature (°C)</label>

            </graph>

        </view>
    </views>

</phyphox>
