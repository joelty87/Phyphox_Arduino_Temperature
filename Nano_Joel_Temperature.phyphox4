<?xml version="1.0" encoding="UTF-8"?>
<phyphox version="1.10">

<title>Nano_Joël Temperature</title>

<data-containers>
    <container size="1000">time</container>
    <container size="1000">temperature</container>
</data-containers>

<inputs>

    <input>
        <bluetooth name="time"/>
        <output>time</output>
    </input>

    <input>
        <bluetooth name="temperature"/>
        <output>temperature</output>
    </input>

</inputs>

<views>

    <view label="Temperature">

        <graph label="Temperature vs Time">

            <input axis="x">time</input>
            <input axis="y">temperature</input>

            <labelX>Time (s)</labelX>
            <labelY>Temperature (°C)</labelY>

        </graph>

    </view>

</views>

</phyphox>
