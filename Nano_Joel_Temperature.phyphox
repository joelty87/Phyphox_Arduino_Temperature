<?xml version="1.0" encoding="UTF-8"?>
<phyphox version="1.10">
<title>Nano_Joël Temperature</title>

<data-containers>
<container size="1000">time</container>
<container size="1000">temperature</container>
</data-containers>

<views>
<view label="Temperature">
<graph label="Temperature vs Time">
<x>time</x>
<y>temperature</y>
</graph>
</view>
</views>

</phyphox>
