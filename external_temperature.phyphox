<?xml version="1.0" encoding="UTF-8"?>
<phyphox version="1.1">

    <title>Arduino External Temperature</title>
    <category>Arduino BLE</category>

    <data-containers>
        <container id="time">
            <name>Time</name>
            <unit>s</unit>
        </container>

        <container id="temp">
            <name>Temperature</name>
            <unit>°C</unit>
        </container>

        <container id="choice">
            <name>Choice</name>
        </container>
    </data-containers>

    <input>
        <bluetooth name="Nano_Joël">
            <output char="0001" conversion="float" index="0" target="time"/>
            <output char="0001" conversion="float" index="1" target="temp"/>
        </bluetooth>
    </input>

    <views>

        <view label="Temperature">

            <graph label="External Temperature">
                <x label="Time (s)" ref="time"/>
                <y label="Temperature (°C)" ref="temp"/>
            </graph>

            <value label="Current Temperature">
                <input ref="temp"/>
            </value>

        </view>

    </views>

</phyphox>
